<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>{{MCP_LABEL}}</string>

    <key>UserName</key>
    <string>_whatsapp</string>
    <key>GroupName</key>
    <string>whatsapp-data</string>

    <key>ProgramArguments</key>
    <array>
        <string>{{NODE_BIN}}</string>
        <string>{{REPO_DIR}}/mcp-http-server.js</string>
    </array>

    <key>WorkingDirectory</key>
    <string>{{REPO_DIR}}</string>

    <key>EnvironmentVariables</key>
    <dict>
        <key>HOME</key>
        <string>/var/empty</string>
        <key>LOG_LEVEL</key>
        <string>warn</string>
        <key>WHATSAPP_MCP_HOST</key>
        <string>127.0.0.1</string>
        <key>WHATSAPP_MCP_PORT</key>
        <string>3055</string>
    </dict>

    <key>RunAtLoad</key>
    <true/>

    <key>KeepAlive</key>
    <true/>

    <key>ThrottleInterval</key>
    <integer>30</integer>

    <key>StandardOutPath</key>
    <string>{{REPO_DIR}}/logs/mcp-http.out.log</string>

    <key>StandardErrorPath</key>
    <string>{{REPO_DIR}}/logs/mcp-http.err.log</string>

    <key>ProcessType</key>
    <string>Background</string>
</dict>
</plist>
