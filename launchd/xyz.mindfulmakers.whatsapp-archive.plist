<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>xyz.mindfulmakers.whatsapp-archive</string>

    <key>UserName</key>
    <string>_whatsapp</string>
    <key>GroupName</key>
    <string>whatsapp-data</string>

    <key>ProgramArguments</key>
    <array>
        <string>/bin/zsh</string>
        <string>-c</string>
        <string>export PATH=&quot;/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin&quot;; exec /Users/shams/.nvm/versions/node/v24.13.1/bin/node /Users/shams/Developer/whatsapp/index.js</string>
    </array>

    <key>WorkingDirectory</key>
    <string>/Users/shams/Developer/whatsapp</string>

    <key>EnvironmentVariables</key>
    <dict>
        <key>QR_OPEN</key>
        <string>0</string>
        <key>LOG_LEVEL</key>
        <string>warn</string>
        <key>HOME</key>
        <string>/var/empty</string>
    </dict>

    <key>RunAtLoad</key>
    <true/>

    <key>KeepAlive</key>
    <true/>

    <key>ThrottleInterval</key>
    <integer>30</integer>

    <key>StandardOutPath</key>
    <string>/Users/shams/Developer/whatsapp/logs/launchd.out.log</string>

    <key>StandardErrorPath</key>
    <string>/Users/shams/Developer/whatsapp/logs/launchd.err.log</string>

    <key>ProcessType</key>
    <string>Background</string>
</dict>
</plist>
